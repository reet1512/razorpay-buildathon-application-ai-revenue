# Copy this file to ".env" and fill in real test-mode values.
# NEVER commit the real ".env" file (see .gitignore).

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Webhook signature verification FAILS CLOSED. With the placeholder secret above
# (anything ending in "xxx"), /webhooks/razorpay rejects every request.
# Set this to 1 ONLY for a local demo without a tunnel. It is ignored when
# APP_ENV=production, and every bypass is logged as webhook_signature_bypass.
# To test the real path instead: set a real webhook secret and sign the body.
ALLOW_UNSIGNED_WEBHOOKS=0
# Optional override (default https://api.razorpay.com/v1)
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Placeholder keys (…xxx) auto dry-run Payment Links. Set 0 with real test keys.
RAZORPAY_DRY_RUN=1

# Phase 7 — default adapter for /execute/run (sim | razorpay)
EXECUTOR_MODE=sim

# SQLite file next to the app. Fine for hackathon; switch later if needed.
DATABASE_URL=sqlite:///./recovery.db

APP_ENV=dev

# Phase 5 — local Ollama (qwen3:8b)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Inherent semantic memory (Phase 2 — optional; default off)
# All application traffic uses the Public API on port 18000 only.
INHERENT_ENABLED=false
INHERENT_BASE_URL=http://localhost:18000
INHERENT_API_KEY=
INHERENT_WORKSPACE_ID=
INHERENT_TIMEOUT_SECONDS=30
INHERENT_POLL_INTERVAL_SECONDS=2
INHERENT_POLL_TIMEOUT_SECONDS=120
INHERENT_MAX_RETRIES=4
INHERENT_SEED_CONCURRENCY=4
INHERENT_SEED_BATCH_SIZE=25
INHERENT_SEARCH_PATH=/v1/search
INHERENT_DOCUMENTS_PATH=/v1/documents
